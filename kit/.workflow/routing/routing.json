{
  "_description": "Router wykonawców. Kolejność kandydatów per typ zadania; --rebalance przebudowuje ją według karty wyników. Dostawca 'other' to przykładowy drugi dostawca (CLI innego modelu) — dopasuj albo usuń. Koszty są względne.",
  "thresholds": {
    "window": 3,
    "avgRoundsAbove": 2,
    "missedAbove": 1,
    "qualityWindow": 5,
    "exploreEvery": 5,
    "costWeight": 0.15,
    "minHistory": 2
  },
  "effortFactor": {
    "low": 0.8,
    "medium": 1,
    "high": 1.4,
    "xhigh": 1.8
  },
  "cost": {
    "mechanic": 1,
    "qa": 2,
    "reviewer": 2,
    "security": 2,
    "implementer": 3,
    "designer": 6,
    "other-cheap": 1,
    "other-main": 2,
    "other-frontier": 5
  },
  "providers": {
    "claude": {
      "command": "Agent(subagent_type: \"{agent}\", prompt: \"Przeczytaj brief {brief} i wykonaj go. Worktree: {worktree}.\")"
    },
    "other": {
      "command": "nohup bash .workflow/bin/run-other.sh {worktree} {brief} {name} {mode} {model} {effort} >/dev/null 2>&1 &"
    }
  },
  "types": {
    "review-scoped": {
      "description": "ponowna recenzja zawężona do diffu rundy (ADDRESSED / NOT ADDRESSED); tylko odczyt",
      "candidates": [
        {
          "provider": "claude",
          "agent": "reviewer"
        },
        {
          "provider": "other",
          "model": "other-main",
          "effort": "medium",
          "mode": "read-only"
        }
      ]
    },
    "review-task": {
      "description": "pełna recenzja zadania: zgodność z briefem, Global Constraints, jakość, testy; tylko odczyt",
      "candidates": [
        {
          "provider": "claude",
          "agent": "reviewer"
        },
        {
          "provider": "other",
          "model": "other-frontier",
          "effort": "medium",
          "mode": "read-only",
          "expensive": true
        }
      ]
    },
    "review-concurrency": {
      "description": "recenzja kodu współbieżnego, sterującego procesami albo stanem (kolejki, blokady, zapisy offline)",
      "candidates": [
        {
          "provider": "claude",
          "agent": "designer",
          "expensive": true
        },
        {
          "provider": "other",
          "model": "other-frontier",
          "effort": "high",
          "mode": "read-only",
          "expensive": true
        }
      ]
    },
    "review-security": {
      "description": "przegląd bezpieczeństwa diffu według przewodnika; tylko odczyt",
      "candidates": [
        {
          "provider": "claude",
